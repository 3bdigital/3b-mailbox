{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "site/app/js/core/**/*.js",
    "site/app/js/gmail/**/*.js",
    "site/app/js/types.js",
    "site/app/js/ui/**/*.js",
    "site/app/js/main.js"
  ]
}
