// Cloudflare Worker that serves the static site in site/. There is no Worker script:
// Cloudflare serves the files directly, so no code runs on the server and nothing is logged by us.
// Deploy: the "Deploy to Cloudflare" GitHub workflow (manual), or `npx wrangler@4 deploy`.
{
  "name": "3b-mailbox-worker",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  // One public address only. Google sign-in client IDs list this origin, so do not change it.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "mailbox.3bweb.com", "custom_domain": true }],
}
